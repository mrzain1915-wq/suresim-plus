<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="@string/app_name"
        android:description="@string/app_description"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives the hook's "activation code copied" broadcast and
             records only the time it happened. The code itself is never
             sent, logged or stored. -->
        <receiver
            android:name=".CopyEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.droidtune.suresim.ACTION_CODE_COPIED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
